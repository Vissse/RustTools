# PostHog analytics. Copy to `.env.local` for local dev (gitignored via *.local),
# and set the same vars in Vercel → Settings → Environment Variables for
# production (Next inlines NEXT_PUBLIC_* at build time).
#
# Analytics is fully disabled when NEXT_PUBLIC_POSTHOG_KEY is unset.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Contact form → WebGlobe mailbox SMTP. Server-only (no NEXT_PUBLIC_ prefix), so
# these are read at runtime and never reach the browser bundle.
#
# NEVER put SMTP_PASS in `.env` — that file is tracked in git. Real values belong
# in `.env.local` locally and in Vercel → Settings → Environment Variables.
#
# /api/contact returns 503 and the form shows an error when SMTP_PASS is unset.
SMTP_HOST=mail.webglobe.cz
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where submissions are delivered. Defaults to SMTP_USER when unset.
CONTACT_TO=
